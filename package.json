{
  "name": "glow-sort",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "levels": "node scripts/gen-levels.mjs",
    "test": "node --test tests/*.test.js",
    "sync": "vite build && cap sync android",
    "android:debug": "VITE_TEST_ADS=1 vite build && cap sync android && cd android && ./gradlew assembleDebug",
    "android:release": "vite build && cap sync android && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "vite": "^7.3.6"
  }
}
